---
import Layout from "../layouts/Layout.astro";
import Icon from "../components/Icon.astro";
import Coins from "reicon/icons/Coins";
import Envelope from "reicon/icons/Envelope";
import Lifebuoy from "reicon/icons/Lifebuoy";
import Rocket from "reicon/icons/Rocket";
import Setting from "reicon/icons/Setting";
import ShieldCheck from "reicon/icons/ShieldCheck";
import Sparkles from "reicon/icons/Sparkles";
import Wallet from "reicon/icons/Wallet";

const benefits = [
  {
    icon: Coins,
    title: "Same price, more benefits",
    text: "Self-hosting requires one server for Coolify and at least one more for your deployments, as recommended. Each server costs around $5 per month. With Cloud hosting, you can get Coolify for the same price, but with additional benefits.",
  },
  {
    icon: ShieldCheck,
    title: "Highly available",
    text: "The Cloud instance is designed to be highly available and always prepared to handle your requests, eliminating the need for you to manage it.",
  },
  {
    icon: Envelope,
    title: "Free emails",
    text: "Email notifications are included in the cost and there is no requirement to pay for a third-party provider.",
  },
  {
    icon: Setting,
    title: "Less maintenance",
    text: "You are not required to manage your Coolify instance. We handle it for you.",
  },
  {
    icon: Lifebuoy,
    title: "Priority support",
    text: "We are available to assist you whenever you require support via Email or Chat.",
  },
  {
    icon: Sparkles,
    title: "Brag about it",
    text: "You can impress anyone by saying that you self-host in the Cloud. They will definitely be amazed.",
  },
];
---

<Layout
  title="Coolify Cloud"
  canonicalUrl="https://coolify.io/cloud/"
  description="Coolify Cloud offers managed hosting with high availability, free emails, and priority support. Same price, more benefits."
>
  <section>
    <h1 class="px-4 text-4xl font-semibold tracking-tight text-balance text-fg md:text-5xl">
      Why use Coolify Cloud<span class="text-warning">?</span>
    </h1>
    <p class="mx-auto mt-4 max-w-2xl px-4 text-base text-pretty text-fg-dim">
      Self-hosting and Cloud... What? Get the same Coolify, managed by us.
    </p>
    <div class="mt-8 flex flex-wrap justify-center gap-3 px-4">
      <a href="https://app.coolify.io/register" class="btn btn-primary btn-lg">
        <Icon icon={Rocket} class="size-4" />
        Get started
      </a>
      <a href="/pricing" class="btn btn-neutral btn-lg">
        <Icon icon={Wallet} class="size-4" />
        Pricing
      </a>
    </div>
  </section>

  <section class="mt-20 px-4">
    <p class="eyebrow">Benefits</p>
    <h2 class="mt-2 text-2xl font-semibold tracking-tight text-fg md:text-3xl">
      Coolify, without the upkeep
    </h2>
    <div class="mt-10 grid gap-3 text-left sm:grid-cols-2 lg:grid-cols-3">
      {
        benefits.map((benefit) => (
          <div class="card p-4">
            <div class="flex size-8 items-center justify-center rounded-md bg-white/[0.06] ring-1 ring-hairline">
              <Icon icon={benefit.icon} class="size-4 text-warning" />
            </div>
            <h3 class="mt-3 text-sm font-medium text-fg">{benefit.title}</h3>
            <p class="mt-1 text-[13px] leading-5 text-fg-faint">{benefit.text}</p>
          </div>
        ))
      }
    </div>
  </section>

  <section class="mt-24 px-4">
    <div class="card flex flex-col items-center gap-5 px-6 py-12">
      <h2 class="text-2xl font-semibold tracking-tight text-fg">Ready to deploy?</h2>
      <p class="max-w-md text-sm text-fg-faint">
        Create your account and connect your first server in minutes.
      </p>
      <div class="flex flex-wrap justify-center gap-3">
        <a href="https://app.coolify.io/register" class="btn btn-primary">Get started</a>
        <a href="/pricing" class="btn btn-neutral">See pricing</a>
      </div>
    </div>
  </section>
</Layout>
