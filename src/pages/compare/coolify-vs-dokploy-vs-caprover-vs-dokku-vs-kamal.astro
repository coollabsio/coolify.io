const escapeHtml = (text) =>
  text.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;");

const sourceLabel = (url) => url.replace(/^https:\/\//, "").replace(/\/$/, "");

// Footnotes are numbered in order of first reference, like Markdown footnotes.
const footnoteNumbers = new Map();
const refLink = (key) => {
  if (!(key in footnotes)) throw new Error(`Missing footnote [^${key}]`);
  const isFirst = !footnoteNumbers.has(key);
  if (isFirst) footnoteNumbers.set(key, footnoteNumbers.size + 1);
  const n = footnoteNumbers.get(key);
  const id = isFirst ? ` id="fnref-${n}"` : "";
  return `<sup><a href="#fn-${n}"${id} aria-label="Footnote ${n}" class="ml-0.5 font-mono text-[10px] text-warning hover:underline">${n}</a></sup>`;
};

const renderInline = (text) =>
  escapeHtml(text)
    .replace(/`([^`]+)`/g, '<code class="rounded bg-white/[0.06] px-1 py-0.5 font-mono text-[12px] text-fg">$1</code>')
    .replace(/\[\^(\d+)\]/g, (_, key) => refLink(key));

const renderFootnote = (text) =>
  renderInline(text.replace(/\s*(\[[A-Z]+\d+\])+$/, "")) +
  " " +
  [...text.matchAll(/\[([A-Z]+\d+)\]/g)]
    .flatMap(([, code]) => {
      if (!sources[code]) throw new Error(`Missing source [${code}]`);
      return sources[code];
    })
    .map((url) => `<a href="${url}" class="text-fg-faint underline decoration-fg-faint/50 underline-offset-2 hover:text-fg">${sourceLabel(url)}</a>`)
    .join(", ");

const renderedRows = rows.map(([feature, hint, ...cells]) => ({
  feature,
  hint,
  cells: cells.map(renderInline),
}));

const unreferenced = Object.keys(footnotes).filter((key) => !footnoteNumbers.has(key));
if (unreferenced.length) throw new Error(`Unreferenced footnotes: ${unreferenced.join(", ")}`);

const renderedFootnotes = [...footnoteNumbers.entries()].map(([key, n]) => ({
  n,
  html: renderFootnote(footnotes[key]),
}));

const faq = [
  {
    question: "Is Coolify or Dokploy better?",
    answer:
