---
import Layout from "../layouts/Layout.astro";
import Contributors from "../components/Contributors.svelte";
---

<Layout
  title="Contributors | Coolify"
  canonicalUrl="https://coolify.io/contributors/"
  description="Meet the amazing developers building Coolify. Join our open-source community and help shape the future of self-hosting."
>
  <h1 class="px-4 text-4xl font-semibold tracking-tight text-balance text-fg md:text-5xl">
    Contributors<span class="text-warning">.</span>
  </h1>
  <p class="mx-auto mt-4 max-w-2xl px-4 text-base text-pretty text-fg-dim">
    Meet the incredible developers who are building Coolify.
  </p>
  <Contributors client:load />
</Layout>
