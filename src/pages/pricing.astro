---
import Layout from "../layouts/Layout.astro";
import Plans from "../components/Pricing/Plans.svelte";
---

<Layout
  title="Coolify Pricing: Cloud from $5/mo, self-hosted free"
  canonicalUrl="https://coolify.io/pricing"
  description="Coolify Cloud starts at $5/month for two servers, plus $3 per extra server. Self-hosted Coolify stays free forever and includes every feature."
>
  <h1 class="px-4 text-4xl font-semibold tracking-tight text-balance text-fg md:text-5xl">
    Pricing<span class="text-warning">.</span>
  </h1>
  <p class="mx-auto mt-4 max-w-2xl px-4 text-base text-pretty text-fg-dim">
    Pricing that adjusts according to your needs.
  </p>
  <Plans client:load />
</Layout>
