---
import Layout from "../layouts/Layout.astro";
import { marked } from "marked";

marked.setOptions({
  gfm: true,
});

const githubToken = import.meta.env.GITHUB_TOKEN ?? process.env.GITHUB_TOKEN;

const headers: Record<string, string> = {
  Accept: "application/vnd.github+json",
  "User-Agent": "coolify-landing",
};

if (githubToken) {
  headers.Authorization = `Bearer ${githubToken}`;
}

let releases: any[] = [];

try {
  const response = await fetch("https://api.github.com/repos/coollabsio/coolify/releases", {
    headers,
  });

  if (response.ok) {
    const data = await response.json();
    releases = Array.isArray(data) ? data : [];
  }
} catch {
  releases = [];
}

const parsedReleases = await Promise.all(
  releases.map(async (release: any) => ({
    name: release.name || release.tag_name,
    tag: release.tag_name,
    date: release.published_at || release.created_at,
    url: release.html_url,
    body: await marked.parse(release.body || ""),
  })),
);
---

<Layout
  title="Changelog | Coolify"
  canonicalUrl="https://coolify.io/changelog/"
  description="Latest Coolify releases and updates from the GitHub repository."
>
  <h1 class="px-4 text-4xl font-semibold tracking-tight text-balance text-fg md:text-5xl">
    Changelog<span class="text-warning">.</span>
  </h1>
  <p class="mx-auto mt-4 max-w-2xl px-4 text-base text-pretty text-fg-dim">
    Latest releases from the <a
      href="https://github.com/coollabsio/coolify"
      class="text-fg underline decoration-fg-faint underline-offset-2 transition-colors hover:decoration-fg"
      target="_blank"
      rel="noopener"
    >GitHub repository</a>.
  </p>

  <section class="mx-auto mt-16 max-w-3xl px-4 pb-16 text-left">
    {parsedReleases.length === 0 && (
      <div class="card p-6 text-center text-sm text-fg-dim">
        Unable to load releases right now.
      </div>
    )}

    {parsedReleases.map((release: any) => (
      <article class="grid gap-4 border-t border-hairline py-8 first:border-t-0 first:pt-0 md:grid-cols-[10rem_1fr] md:gap-8">
        <div class="flex flex-wrap items-center gap-x-3 gap-y-2 md:flex-col md:items-start">
          {release.tag && (
            <a
              href={release.url}
              target="_blank"
              rel="noopener"
              class="inline-flex rounded-full bg-white/[0.04] px-2.5 py-0.5 font-mono text-xs text-fg-dim ring-1 ring-hairline transition-colors hover:bg-white/[0.07] hover:text-fg focus-visible:outline-1 focus-visible:outline-offset-2 focus-visible:outline-warning"
            >
              {release.tag}
            </a>
          )}
          {release.date && (
            <time datetime={release.date} class="text-xs text-fg-faint">
              {new Date(release.date).toLocaleDateString("en-US", {
                year: "numeric",
                month: "long",
                day: "numeric",
              })}
            </time>
          )}
        </div>

        <div class="min-w-0">
          {release.name !== release.tag && (
            <h2 class="text-lg font-semibold tracking-tight text-fg">
              <a
                href={release.url}
                target="_blank"
                rel="noopener"
                class="transition-colors hover:text-warning"
              >
                {release.name}
              </a>
            </h2>
          )}

          <div
            class="prose prose-invert max-w-none min-w-0 wrap-anywhere [&>:first-child]:mt-0 [h2+&]:mt-3 text-[15px] leading-7 text-fg-dim
            prose-headings:mb-2 prose-headings:mt-6 prose-headings:font-semibold prose-headings:tracking-tight prose-headings:text-fg
            prose-h1:text-lg prose-h2:text-base prose-h3:text-[15px] prose-h4:text-[15px]
            prose-p:my-3 prose-p:text-fg-dim
            prose-a:font-normal prose-a:text-fg prose-a:underline prose-a:decoration-fg-faint prose-a:underline-offset-2 hover:prose-a:decoration-fg
            prose-strong:text-fg
            prose-ul:my-3 prose-ol:my-3 prose-li:my-1 prose-li:text-fg-dim prose-li:marker:text-fg-faint
            prose-code:rounded prose-code:bg-white/[0.06] prose-code:px-1 prose-code:py-0.5 prose-code:font-mono prose-code:text-[13px] prose-code:font-normal prose-code:text-fg prose-code:before:content-none prose-code:after:content-none
            prose-pre:rounded-lg prose-pre:bg-white/[0.04] prose-pre:ring-1 prose-pre:ring-hairline
            prose-blockquote:border-hairline prose-blockquote:font-normal prose-blockquote:not-italic prose-blockquote:text-fg-dim
            prose-hr:border-hairline
            prose-img:rounded-lg"
            set:html={release.body}
          />
        </div>
      </article>
    ))}
  </section>
</Layout>
