---
import Icon from "./Icon.astro";
import Menu from "reicon/icons/Menu";
---

<header class="sticky top-0 z-50 bg-app/30 backdrop-blur-xl">
  <nav class="mx-auto flex h-14 max-w-7xl items-center justify-between gap-6 px-4">
    <a href="/" class="flex shrink-0 items-center gap-2">
      <img src="/android-launchericon-48-48.png" alt="" class="size-6" />
      <span class="text-base font-semibold tracking-tight text-fg">Coolify</span>
    </a>
    <div id="desktop-menu" class="hidden flex-1 items-center gap-0.5 xl:flex">
      <a class="navbar-link" href="/philosophy">Philosophy</a>
      <a class="navbar-link" href="/pricing">Pricing</a>
      <a class="navbar-link" href="/services">Services</a>
      <a class="navbar-link" href="https://coolify.io/docs/">Docs</a>
      <a class="navbar-link" href="/changelog">Changelog</a>
      <a class="navbar-link" href="/contributors">Contributors</a>
      <a class="navbar-link" href="/sponsorships">Sponsor us</a>
      <a class="navbar-link" href="https://shop.coollabs.io?utm_source=coolify">Merch</a>
    </div>
    <div class="flex items-center gap-2">
      <a class="navbar-link hidden! xl:flex!" href="https://coollabs.io/discord">
        <svg
        class="size-4"
        viewBox="0 0 256 256"
        xmlns="http://www.w3.org/2000/svg"
        ><g fill="currentColor"
          ><path
            d="m235.21 185.59l-67 29.7a8.15 8.15 0 0 1-11-4.56L147 183.06a190.5 190.5 0 0 1-19 .94a190.5 190.5 0 0 1-19-.94l-10.25 27.67a8.15 8.15 0 0 1-11 4.56l-67-29.7a8 8 0 0 1-4.55-9.24L45.77 60a8.08 8.08 0 0 1 6.54-6l36.06-5.92a8.1 8.1 0 0 1 9.21 6l5 19.63a192.32 192.32 0 0 1 50.88 0l5-19.63a8.1 8.1 0 0 1 9.21-6L203.69 54a8.08 8.08 0 0 1 6.54 6l29.53 116.37a8 8 0 0 1-4.55 9.22"
            opacity=".2"></path><path
            d="M104 140a12 12 0 1 1-12-12a12 12 0 0 1 12 12m60-12a12 12 0 1 0 12 12a12 12 0 0 0-12-12m74.45 64.9l-67 29.71a16.17 16.17 0 0 1-21.71-9.1l-8.11-22q-6.72.45-13.63.46t-13.63-.46l-8.11 22a16.18 16.18 0 0 1-21.71 9.1l-67-29.71a15.94 15.94 0 0 1-9.06-18.51L38 58a16.08 16.08 0 0 1 13-11.87l36.06-5.92a16.21 16.21 0 0 1 18.26 11.88l3.26 12.83Q118.11 64 128 64t19.4.92l3.26-12.83a16.22 16.22 0 0 1 18.26-11.88L205 46.13A16.08 16.08 0 0 1 218 58l29.53 116.38a15.94 15.94 0 0 1-9.08 18.52M232 178.28L202.47 62h-.08l-36.06-6a.17.17 0 0 0-.17 0l-2.83 11.14c5 .94 10 2.06 14.83 3.42A8 8 0 0 1 176 86.31a8.09 8.09 0 0 1-2.16-.3A172.25 172.25 0 0 0 128 80a172.25 172.25 0 0 0-45.84 6a8 8 0 1 1-4.32-15.4c4.82-1.36 9.78-2.48 14.82-3.42L89.83 56a.21.21 0 0 0-.12 0l-36.1 5.92a.24.24 0 0 0-.09 0L24 178.33L91 208a.21.21 0 0 0 .22 0L98 189.72a173.2 173.2 0 0 1-20.14-4.32a8 8 0 0 1 4.3-15.4a171.85 171.85 0 0 0 45.84 6a171.85 171.85 0 0 0 45.84-6a8 8 0 0 1 4.32 15.41a173.2 173.2 0 0 1-20.16 4.31l6.75 18.28a.22.22 0 0 0 .21 0Z"
          ></path></g
        ></svg
      >
        Community <span class="community-count text-fg-faint tabular-nums">20k+</span>
      </a>
      <a class="btn btn-primary hidden sm:inline-flex" href="https://app.coolify.io">To Cloud</a>
      <button
        id="mobile-menu-button"
        type="button"
        aria-label="Toggle menu"
        aria-controls="mobile-menu"
        class="flex size-9 items-center justify-center rounded-md text-fg-dim hover:bg-white/[0.06] hover:text-fg xl:hidden"
      >
        <Icon icon={Menu} class="size-5" />
      </button>
    </div>
  </nav>
  <div id="mobile-menu" class="hidden flex-col gap-0.5 border-t border-hairline px-4 py-3 xl:hidden!">
    <a class="navbar-link" href="/philosophy">Philosophy</a>
    <a class="navbar-link" href="/pricing">Pricing</a>
    <a class="navbar-link" href="/services">Services</a>
    <a class="navbar-link" href="https://coolify.io/docs/">Docs</a>
    <a class="navbar-link" href="/changelog">Changelog</a>
    <a class="navbar-link" href="/contributors">Contributors</a>
    <a class="navbar-link" href="/sponsorships">Sponsor us</a>
    <a class="navbar-link" href="https://shop.coollabs.io?utm_source=coolify">Merch</a>
    <a class="navbar-link" href="https://coollabs.io/discord">
      Community <span class="community-count text-fg-faint tabular-nums">20k+</span>
    </a>
    <a class="btn btn-primary mt-2 w-full sm:hidden" href="https://app.coolify.io">To Cloud</a>
  </div>
</header>

<script>
  fetch("https://cdn.coollabs.io/business.json")
    .then((res) => res.json())
    .then((data) => {
      if (!data.discord) return;
      document.querySelectorAll(".community-count").forEach((el) => {
        el.textContent = `${(data.discord / 1000).toFixed(0)}k+`;
      });
    })
    .catch(() => {});
</script>
