---
import Icon from "./Icon.astro";
import Coins from "reicon/icons/Coins";
import Rocket from "reicon/icons/Rocket";
---

<div class="mt-8 flex flex-wrap gap-3">
  <a href="https://coolify.io/docs/start-with-self-hosted" class="btn btn-primary btn-lg">
    <Icon icon={Rocket} class="size-4" />
    Start self-hosting
  </a>
  <a href="/pricing" class="btn btn-neutral btn-lg">
    <Icon icon={Coins} class="size-4" />
    See pricing
  </a>
</div>
